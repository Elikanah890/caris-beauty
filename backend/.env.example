# Copy to .env and fill in — NEVER commit .env
# Render: HOST=0.0.0.0, COOKIE_SECURE=true,
#         CORS_ORIGIN=https://your-vercel-app.vercel.app
# Neon:   copy the connection string from the Neon dashboard, including
#         ?sslmode=require. SSL is enabled automatically for *.neon.tech.
NODE_ENV=production
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgres://duka_app:CHANGE_ME@127.0.0.1:5432/duka_db
# Neon example:
# DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
TEST_DATABASE_URL=postgres://duka_app:CHANGE_ME@127.0.0.1:5432/duka_test
JWT_ACCESS_SECRET=CHANGE_ME_48_BYTE_BASE64URL
JWT_REFRESH_SECRET=CHANGE_ME_48_BYTE_BASE64URL
ACCESS_TOKEN_TTL=8h
REFRESH_TOKEN_TTL=30d
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=false
